    "lucide-react": "0.575.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "10.6.0",
    "typescript-eslint": "8.62.0",
    "vitest": "4.1.0",
    "jsdom": "28.1.0"
  }
}
