:8090 {
    bind 127.0.0.1
    encode zstd gzip

    @adminRoot {
        host portal-system.gabineteitinerante.com.br
        path /
    }
    redir @adminRoot /admin/login 302

    @publicAdmin {
        host portal.gabineteitinerante.com.br
        path /admin*
    }
    redir @publicAdmin https://portal-system.gabineteitinerante.com.br{uri} 302

    @publicAdminApi {
        host portal.gabineteitinerante.com.br
        path /api/admin/*
    }
    respond @publicAdminApi 404

    handle /api/* {
        reverse_proxy 127.0.0.1:8000
    }

    handle /media/* {
        reverse_proxy 127.0.0.1:8000
    }

    handle /health/* {
        reverse_proxy 127.0.0.1:8000
    }

    handle {
        root * ./frontend/dist
        try_files {path} /index.html
        file_server
    }
}
