APP_ENV=production
DEBUG=false
PUBLIC_BASE_URL=https://portal.gabineteitinerante.com.br
ALLOWED_ORIGINS=https://portal.gabineteitinerante.com.br,https://portal-system.gabineteitinerante.com.br
TRUSTED_PROXY_IPS=172.20.0.10

DATABASE_URL=postgresql+psycopg://captive_app:REPLACE_ME@REPLACE_ME.neon.tech/captive?sslmode=require
MIGRATION_DATABASE_URL=postgresql+psycopg://captive_owner:REPLACE_ME@REPLACE_ME.neon.tech/captive?sslmode=require
SECRET_KEY=REPLACE_WITH_64_RANDOM_CHARS
FERNET_KEY=REPLACE_WITH_FERNET_KEY

UNIFI_BASE_URL=https://unifi.gabineteitinerante.com.br:11443
UNIFI_API_KEY=REPLACE_WITH_UNIFI_API_KEY
UNIFI_SITE=Default
UNIFI_API_PREFIX=/proxy/network/integration/v1
UNIFI_VERIFY_SSL=true

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@example.com
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
SMTP_FROM=Wi-Fi Guest <no-reply@example.com>

EMAIL_CODE_TTL_MINUTES=15
DATA_RETENTION_DAYS=90
RATE_LIMIT_WINDOW_SECONDS=3600
RATE_LIMIT_MAX_ATTEMPTS=8
PROVISIONAL_ACCESS_MINUTES=1
AUTH_FORM_ACCESS_MINUTES=5
